# Copy to .env and edit if you need to point at a different backend.
# Vite bakes this at BUILD time — rebuild the image after changing.

# Full base URL of the Tutor API (including any path prefix the
# backend exposes). Code uses `/v1/...` paths, so the value below
# resolves to https://tutor-api.webspacehub.com/api/v1/...
VITE_API_BASE_URL=https://tutor-api.webspacehub.com/api
