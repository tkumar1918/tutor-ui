# Copy to .env and edit if you need a non-default API URL.
# Vite bakes this at BUILD time — rebuild the image after changing.

# Base URL of the Tutor API that the browser calls.
# The browser runs on the host, so localhost:8080 works when the
# backend's docker compose publishes 8080 on the host.
VITE_API_BASE_URL=http://localhost:8080
