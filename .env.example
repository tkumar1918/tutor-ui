# Copy to .env only if you need to point at a different backend than the
# default `/api` (same-origin proxy). Vite bakes this at BUILD time —
# rebuild the image after changing.
#
# Default `/api` means the bundle calls `/api/v1/...` on whatever origin
# served it; host nginx is expected to proxy `/api/` to the backend.
VITE_API_BASE_URL=/api
