# Copy to .env and edit if you need a non-default API base.
# Vite bakes this at BUILD time — rebuild the image after changing.

# Base URL the browser uses for API calls.
#
# Default: `/api` (same-origin). The nginx in the frontend container
# reverse-proxies /api/* to the backend container, so there's no CORS
# and no host-coupling baked into the bundle.
#
# Override only if you're skipping the proxy and pointing the SPA
# directly at a different host, e.g. http://api.example.com
VITE_API_BASE_URL=/api
